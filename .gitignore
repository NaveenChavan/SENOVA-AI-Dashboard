fastembed_cache/
backend/pytest_output.txt
backend/bisect_*.py
scratch/
backend/scratch/

# --- Frontend (Node) ---
frontend/node_modules/
frontend/dist/
frontend/*.log
frontend/.vercel/
npm-debug.log*
*.timestamp-*.mjs

