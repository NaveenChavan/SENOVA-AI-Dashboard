# Copy to `.env` and fill in real values. Never commit `.env` to git.

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
# For local dev, the Vite defaults below are enough. Once deployed, ADD
# your Vercel production domain (and any preview-deployment domains you
# use) here, e.g.:
#   CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Environment ---
# One of "development" or "production". Defaults to "development" if unset.
# Startup refuses to boot if DISABLE_AUTH=true while ENV=production — this
# is the safety net against accidentally deploying with auth disabled.
ENV=development

# --- Firebase Auth (Admin SDK) ---
# Supply the service account ONE of two ways (checked in this order):
#
# 1) FIREBASE_SERVICE_ACCOUNT_JSON — the entire service-account JSON on one
#    line. Use this on a deployed host (Render/Railway/Fly): the key file is
#    gitignored, so it can never reach the host via the repo. Paste the whole
#    file contents including the outer { }. If your host mangles newlines, a
#    private_key containing literal \n is repaired automatically.
FIREBASE_SERVICE_ACCOUNT_JSON=
# 2) FIREBASE_SERVICE_ACCOUNT_PATH — path to the JSON file on disk. This is the
#    local-development option. Download from:
#    Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_PROJECT_ID=senova-dashboard
# Set to "true" only for local development without Firebase credentials.
# Refused at startup if ENV=production (see above).
DISABLE_AUTH=false

# --- Frame cache (memory tuning) ---
# Sized for a small host by default. A Render free instance has 512 MB total,
# shared with pandas/numpy and every in-flight request, so keep these low
# there; raise them on a bigger instance to trade RAM for fewer re-parses.
FRAME_CACHE_MAX_ENTRIES=3
FRAME_CACHE_MAX_ROWS=120000

# --- Password reset email (SendGrid) ---
# API key from SendGrid > Settings > API Keys (Restricted Access > Mail Send
# only is sufficient). Required for the /auth/forgot-password endpoint to
# actually send mail; leave blank in environments that don't send email.
SENDGRID_API_KEY=
# The "From" address for password-reset emails. Must be on a domain that has
# completed SendGrid's Sender Authentication (domain-level SPF/DKIM) —
# sending from an unauthenticated domain is what lands these in spam.
SENDER_EMAIL=noreply@yourdomain.com
# Base URL of the deployed frontend (no trailing slash). Used to build the
# branded https://<APP_DOMAIN>/reset-password-confirm link sent to users,
# replacing Firebase's default firebaseapp.com hosted action page.
APP_DOMAIN=http://localhost:5173

# --- Uploads ---
UPLOAD_DIR=temp_uploads
MAX_UPLOAD_SIZE_MB=50
UPLOAD_TTL_MINUTES=120
UPLOAD_SWEEP_INTERVAL_MINUTES=30
