# Copy to `.env` and fill in real values. Never commit `.env` to git.

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Firebase Auth (Admin SDK) ---
# Path to the service-account JSON downloaded from:
# Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_PROJECT_ID=senova-dashboard
# Set to "true" only for local development without Firebase credentials.
DISABLE_AUTH=false

# --- Uploads ---
UPLOAD_DIR=temp_uploads
MAX_UPLOAD_SIZE_MB=50
UPLOAD_TTL_MINUTES=120
UPLOAD_SWEEP_INTERVAL_MINUTES=30
